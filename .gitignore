# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Documentacion y archivos Word/Markdown adicionales (solo se incluye README.md)
*.docx
*.md
!README.md

# Imagenes en raiz
/*.png

# Imagenes secundarias en public (solo se incluye la referencia de diseno)
public/diagrama_*.png
public/references/airbnb_experiences_reference.png
public/references/getyourguide_reference.png
!public/references/dribbble_travel_cards_reference.png
